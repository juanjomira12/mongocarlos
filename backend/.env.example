# Entorno de ejecucion: development | production
# En produccion el token de recuperacion NO se devuelve en la respuesta.
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Conexion a MongoDB Atlas
# Copiar la cadena desde Atlas > Connect > Drivers y reemplazar
# <usuario>, <clave> y el nombre de la base de datos.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/agenda_db?retryWrites=true&w=majority

# Clave para firmar los JWT (usar un valor largo y aleatorio)
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=1d
